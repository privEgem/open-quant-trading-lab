      "type": "object",
      "required": ["run_id", "queue_render_timestamp_utc", "queue_renderer_version"],
      "properties": {
        "run_id": {"type": "string"},
        "queue_render_timestamp_utc": {"type": "string", "format": "date-time"},
        "queue_renderer_version": {"type": "string"}
      },
      "additionalProperties": false
    },
    "item": {"$ref": "normalized_item.schema.json"}
  }, "additionalProperties": false
}

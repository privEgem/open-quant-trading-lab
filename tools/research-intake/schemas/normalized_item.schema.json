{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["identity", "bibliographic", "links", "provenance", "relevance", "lifecycle", "review"],
  "properties": {
    "identity": {
      "type": "object",
      "required": ["schema_version", "item_id", "record_type", "primary_key_type", "primary_key_value", "base_arxiv_id", "current_arxiv_version", "doi", "doi_status"],
      "properties": {
        "schema_version": {"const": 1},
        "item_id": {"type": "string", "pattern": "^ri_[0-9a-f]{64}$"},
        "record_type": {"const": "research_paper"},
        "primary_key_type": {"const": "arxiv"},
        "primary_key_value": {"type": "string", "minLength": 1},
        "base_arxiv_id": {"type": "string", "minLength": 1},
        "current_arxiv_version": {"type": "string", "pattern": "^v[0-9]+$"},
        "doi": {"type": ["string", "null"], "minLength": 1},
        "doi_status": {"enum": ["not_provided", "provided_by_primary_source"]}
      },
      "additionalProperties": false
    },
    "bibliographic": {
      "type": "object",
      "required": ["title", "authors", "abstract", "language", "primary_category", "categories", "submitted_at", "source_updated_at", "journal_reference", "comments", "license"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "authors": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "abstract": {"type": "string", "minLength": 1},
        "language": {"type": "string", "minLength": 1},
        "primary_category": {"type": "string", "minLength": 1},
        "categories": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "submitted_at": {"type": "string", "format": "date-time"},
        "source_updated_at": {"type": "string", "format": "date-time"},
        "journal_reference": {"type": ["string", "null"]},
        "comments": {"type": ["string", "null"]},
        "license": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "links": {
      "type": "object",
      "required": ["source_record_url", "pdf_url", "doi_url"],
      "properties": {
        "source_record_url": {"type": "string", "format": "uri"},
        "pdf_url": {"type": ["string", "null"], "format": "uri"},
        "doi_url": {"type": ["string", "null"], "format": "uri"}
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["primary_source", "source_record_id", "discovery_query_ids", "retrieved_at", "run_id", "raw_artifact_path", "raw_artifact_sha256", "normalizer_version"],
      "properties": {
        "primary_source": {"const": "arxiv"},
        "source_record_id": {"type": "string", "format": "uri"},
        "discovery_query_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "run_id": {"type": "string", "minLength": 1},
        "raw_artifact_path": {"type": "string", "minLength": 1},
        "raw_artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "normalizer_version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "relevance": {
      "type": "object",
      "required": ["eligible", "score", "priority", "matched_rule_ids", "penalty_rule_ids", "contributions", "explanation"],
      "properties": {
        "eligible": {"type": "boolean"},
        "score": {"type": "integer", "maximum": 100},
        "priority": {"enum": ["HIGH", "MEDIUM", "LOW", "EXCLUDED"]},
        "matched_rule_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "penalty_rule_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "contributions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["rule_id", "points"],
            "properties": {"rule_id": {"type": "string", "minLength": 1}, "points": {"type": "integer"}},
            "additionalProperties": false
          }
        },
        "explanation": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "lifecycle": {
      "type": "object",
      "required": ["first_seen_at", "last_seen_at", "first_seen_run_id", "last_seen_run_id", "latest_source_version"],
      "properties": {
        "first_seen_at": {"type": "string", "format": "date-time"},
        "last_seen_at": {"type": "string", "format": "date-time"},
        "first_seen_run_id": {"type": "string", "minLength": 1},
        "last_seen_run_id": {"type": "string", "minLength": 1},
        "latest_source_version": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "required": ["status", "priority", "reviewer", "reviewed_at", "tags", "notes"],
      "properties": {
        "status": {"enum": ["NEW", "REVIEWING", "KEEP_FOR_DEEP_REVIEW", "EDUCATIONAL_ONLY", "PARKED", "REJECTED", "DUPLICATE"]},
        "priority": {"enum": ["HIGH", "MEDIUM", "LOW", "NONE"]},
        "reviewer": {"type": ["string", "null"]},
        "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
        "tags": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "notes": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

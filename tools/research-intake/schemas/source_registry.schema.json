{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "application", "policy", "sources"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "application": {
      "type": "object",
      "required": ["name", "version", "user_agent"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "user_agent": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "required": ["request_timeout_seconds", "retry", "minimum_request_interval_seconds", "maximum_requests_per_run", "overlap_seconds", "global_maximum_runtime_seconds", "global_maximum_items_per_run"],
      "properties": {
        "request_timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "minimum_request_interval_seconds": {"type": "number", "minimum": 0},
        "maximum_requests_per_run": {"type": "integer", "minimum": 1},
        "overlap_seconds": {"type": "integer", "minimum": 0},
        "global_maximum_runtime_seconds": {"type": "integer", "minimum": 1},
        "global_maximum_items_per_run": {"type": "integer", "minimum": 1},
        "retry": {
          "type": "object",
          "required": ["max_attempts", "base_delay_seconds", "retry_statuses"],
          "properties": {
            "max_attempts": {"type": "integer", "minimum": 1},
            "base_delay_seconds": {"type": "number", "minimum": 0},
            "retry_statuses": {"type": "array", "items": {"type": "integer", "minimum": 100, "maximum": 599}, "uniqueItems": true}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "enabled", "access_method", "endpoint", "collection", "queries"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_.-]+$"},
          "enabled": {"type": "boolean"},
          "access_method": {"type": "string"},
          "endpoint": {"type": "string", "format": "uri"},
          "collection": {
            "type": "object",
            "required": ["metadata", "abstracts", "pdfs"],
            "properties": {"metadata": {"type": "boolean"}, "abstracts": {"type": "boolean"}, "pdfs": {"type": "boolean"}},
            "additionalProperties": false
          },
          "queries": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "enabled", "expression", "eligibility_mode", "maximum_results"],
              "properties": {
                "id": {"type": "string", "pattern": "^[a-z0-9_.-]+$"},
                "enabled": {"type": "boolean"},
                "expression": {"type": "string", "minLength": 1},
                "eligibility_mode": {"enum": ["category_unconditional", "topic_required"]},
                "maximum_results": {"type": "integer", "minimum": 1}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  }
}
